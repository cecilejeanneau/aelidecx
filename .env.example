# Aelidecx — Configuration

# Port du serveur (défaut: 3000)
PORT=3000

# Adresse d'écoute (défaut sécurisé: localhost uniquement)
# Pour accès depuis un PC du même réseau/hotspot: 0.0.0.0
BIND_ADDR=127.0.0.1

# Environnement applicatif: dev | development | production
APP_ENV=production

# 🔐 IMPORTANT: Clé API pour sécuriser l'accès
# Remplace cette clé par quelque chose de fort et unique
# ex: openssl rand -base64 32
# Cette clé doit être gardée secrète et changée en production
API_KEY=ton-api-key-forte-ici-change-moi

# Rotation des secrets sans coupure: liste de clés valides (nouvelle en premier)
# Ex: API_KEYS=new_secret_2026,old_secret_2025
# Si défini, API_KEYS est prioritaire sur API_KEY
# API_KEYS=

# Origines autorisées pour CORS (séparées par virgule)
# Laisser vide pour défaut local strict
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# HTTPS optionnel (fortement recommandé si exposition réseau)
# TLS_CERT_FILE=/path/to/fullchain.pem
# TLS_KEY_FILE=/path/to/privkey.pem

# Chemin vers la base de données (défaut: ../data/notes.db)
# DATABASE_PATH=../data/notes.db

# Chemin vers le dossier uploads (défaut: ../uploads)
# UPLOADS_DIR=../uploads

# Limite de taille pour upload d'images (défaut: 10 MB)
# MAX_UPLOAD_SIZE=10485760

# Mode debug (pour futurs logs améliorés)
# DEBUG=false
